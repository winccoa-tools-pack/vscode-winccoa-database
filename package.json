{
  "name": "vscode-winccoa-database",
  "displayName": "WinCC OA Database Explorer",
  "description": "Browse and edit WinCC OA datapoint types and datapoints directly from VS Code",
  "version": "0.1.0",
  "publisher": "winccoa-tools-pack",
  "author": "winccoa-tools-pack",
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "wincc-oa",
    "scada",
    "hmi",
    "siemens",
    "etm",
    "industrial",
    "automation",
    "database",
    "datapoints"
  ],
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/winccoa-tools-pack/vscode-winccoa-database"
  },
  "bugs": {
    "url": "https://github.com/winccoa-tools-pack/vscode-winccoa-database/issues"
  },
  "homepage": "https://github.com/winccoa-tools-pack/vscode-winccoa-database#readme",
  "engines": {
    "vscode": "^1.106.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "winccoa-database",
          "title": "WinCC OA Database",
          "icon": "resources/icons/database.svg"
        }
      ]
    },
    "views": {
      "winccoa-database": [
        {
          "id": "winccoa-database.dptView",
          "name": "Datapoint Types & Datapoints"
        }
      ]
    },
    "commands": [
      {
        "command": "winccoa-database.refreshDptTree",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "WinCC OA Database"
      },
      {
        "command": "winccoa-database.openConfigEditor",
        "title": "Open Config Editor",
        "category": "WinCC OA Database"
      },
      {
        "command": "winccoa-database.selectProject",
        "title": "Select WinCC OA Project",
        "category": "WinCC OA Database"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "winccoa-database.refreshDptTree",
          "when": "view == winccoa-database.dptView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "WinCC OA Database",
      "properties": {
        "winccoa-database.projectPath": {
          "type": "string",
          "default": "",
          "description": "Path to WinCC OA project directory. Leave empty for auto-detection."
        }
      }
    }
  },
  "extensionDependencies": [],
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.2",
    "glob": "^13.0.0",
    "markdownlint-cli": "^0.47.0",
    "mocha": "^11.3.0",
    "prettier": "^3.8.1",
    "source-map": "^0.8.0-beta.0",
    "ts-loader": "^9.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.54.0",
    "webpack": "^5.105.2",
    "webpack-cli": "^5.1.4"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "rebuild": "electron-rebuild -v 39.3.0",
    "compile": "webpack --mode production && npm run copy-fixtures",
    "copy-fixtures": "copyfiles -u 1 \"src/test/fixtures/**/*\" dist/",
    "build": "npm run compile",
    "start": "code --extensionDevelopmentPath=.",
    "start:insiders": "code-insiders --extensionDevelopmentPath=.",
    "dev": "npm run watch",
    "watch": "webpack --mode development --watch",
    "package": "npm run rebuild && vsce package",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
    "lint:md:fix": "markdownlint \"**/*.md\" --ignore node_modules --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "vscode-test",
    "test:unit": "vscode-test --label unitTests",
    "test:integrationt": "vscode-test --label integrationTests",
    "ci:integration": "npm ci && npm run compile && npm run test:integrationt",
    "style-check": "npm run format:check && npm run lint"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2"
  }
}
